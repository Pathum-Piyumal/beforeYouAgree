{
  "name": "extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test e2e/*.test.mjs",
    "test:integration": "node --test integration/*.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dashboard": "tsc --noEmit && vite build --config vite.dashboard.config.js",
    "lint": "oxlint src vite.config.js vite.dashboard.config.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.54.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
